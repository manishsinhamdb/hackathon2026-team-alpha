# Control Tower — server-side configuration (names only; real values live in .env.local, gitignored).
# The browser NEVER sees any of these: all platform/DB access happens in the Next.js server (BFF) routes.

# --- Platform (chat) ---
PLATFORM_BASE_URL=https://agentic-platform.mongodb.com
PLATFORM_PROJECT_ID=
CHAT_WORKSPACE_ID=

# A NEW project service account created for this UI (do NOT reuse an agent's SA):
#   agentic service-account create control-tower --role AGENT_DEVELOPER --context hackathon2026 --json
PLATFORM_SA_CLIENT_ID=
PLATFORM_SA_CLIENT_SECRET=

# --- Platform DB (READ-ONLY from the UI) ---
POC_PLATFORM_MONGODB_URI=
POC_PLATFORM_DB=poc_builder

# --- UI ---
# The user_id stamped on chat turns (durable-memory identity the platform requires).
UI_USER_ID=u_ui
# Port the server listens on (Next standalone honours PORT; Docker/Kanopy set this).
PORT=3100
