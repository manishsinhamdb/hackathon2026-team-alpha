{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://poc-builder/schemas/schema_design.json",
  "title": "schema_design.json",
  "type": "object",
  "required": [
    "database_name",
    "collections",
    "seed_requirements"
  ],
  "properties": {
    "database_name": {
      "type": "string",
      "pattern": "^poc_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "collections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "fields"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "description": {
            "type": "string"
          },
          "fields": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "name",
                "type"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "required": {
                  "type": "boolean"
                },
                "optional": {
                  "type": "boolean"
                },
                "example": {},
                "dims": {
                  "type": "integer"
                }
              }
            }
          },
          "indexes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "keys"
              ],
              "properties": {
                "keys": {
                  "type": "object",
                  "additionalProperties": {
                    "enum": [
                      1,
                      -1,
                      "text",
                      "2dsphere"
                    ]
                  }
                },
                "unique": {
                  "type": "boolean"
                }
              }
            }
          },
          "relationships": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "field",
                "references",
                "embed_or_reference"
              ],
              "properties": {
                "field": {
                  "type": "string"
                },
                "references": {
                  "type": "string"
                },
                "embed_or_reference": {
                  "type": "string",
                  "enum": [
                    "embed",
                    "reference"
                  ]
                }
              }
            }
          },
          "seed": {
            "type": "object",
            "required": [
              "count"
            ],
            "properties": {
              "count": {
                "type": "integer",
                "minimum": 0
              },
              "generator_hints": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "seed_requirements": {
      "type": "object",
      "required": [
        "max_docs_per_collection",
        "deterministic_seed"
      ],
      "properties": {
        "max_docs_per_collection": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "deterministic_seed": {
          "type": "integer"
        }
      }
    }
  }
}